# Play, record, convert, and stream select audio and video codecs
brew "ffmpeg"
# OCR (Optical Character Recognition) engine
brew "tesseract"
# Adds an OCR text layer to scanned PDF files
brew "ocrmypdf"
# Enables extra languages support for Tesseract
brew "tesseract-lang"
# Terminal emulator — config is managed in Nix (ghostty.nix), app via brew.
# Stable releases. For nightlies swap to cask "ghostty@tip" (self-updates on
# the tip channel).
cask "ghostty"
# System info fetch (the `ff` fish abbr); nix build pulls a 1.3 GiB apple-sdk on macOS
brew "fastfetch"
uv "huggingface-hub[cli]"
