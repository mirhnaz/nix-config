# Terminal emulator — config is managed in Nix (ghostty.nix), app via brew.
# Nightly ("tip") build; self-updates on the tip channel. Swap back to
# cask "ghostty" for stable.
cask "ghostty@tip"
# System info fetch (the `ff` fish abbr); nix build pulls a 1.3 GiB apple-sdk on macOS
brew "fastfetch"
