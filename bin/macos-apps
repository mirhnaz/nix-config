#!/usr/bin/env python3
"""Regenerate the inventory section of macos/apps.md from /Applications.

Usage: macos-apps [path/to/apps.md]

Classifies every app in /Applications (and one folder level below, e.g.
"Adobe Acrobat DC/") as installed by a Homebrew cask, the App Store, work MDM
(names listed between the managed:start/end markers in apps.md), Apple, or
manual. Manual apps are matched against Homebrew's cask index by .app name so
the "migrate to Brewfile" list names real casks. Only the block between the
BEGIN/END GENERATED markers is rewritten; everything else is hand-curated.

Plain Python rather than a shell script so it runs the same from fish or bash.
"""

import datetime
import json
import os
import plistlib
import re
import subprocess
import sys
import time
import urllib.request

REPO = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
APPS_MD = sys.argv[1] if len(sys.argv) > 1 else os.path.join(REPO, "macos/apps.md")
BREWFILE = os.path.join(REPO, "macos/Brewfile")
BEGIN = "<!-- BEGIN GENERATED by bin/macos-apps: edits here are overwritten -->"
END = "<!-- END GENERATED -->"
CASK_API = "https://formulae.brew.sh/api/cask.json"
CACHE = os.path.expanduser("~/Library/Caches/macos-apps/cask.json")
SKIP_DIRS = {"Utilities"}  # Apple's own folder


def list_apps():
    """Return {display name: path} for /Applications/*.app and */*.app."""
    apps = {}
    for entry in sorted(os.listdir("/Applications"), key=str.lower):
        path = os.path.join("/Applications", entry)
        if entry.endswith(".app"):
            apps[entry] = path
        elif os.path.isdir(path) and entry not in SKIP_DIRS:
            for sub in sorted(os.listdir(path), key=str.lower):
                if sub.endswith(".app"):
                    apps[f"{entry}/{sub}"] = os.path.join(path, sub)
    return apps


def bundle_id(path):
    try:
        with open(os.path.join(path, "Contents/Info.plist"), "rb") as f:
            return plistlib.load(f).get("CFBundleIdentifier", "")
    except Exception:
        return ""


def load_cask_index():
    """Map "Foo.app" -> [cask tokens], from Homebrew's API (cached for a day).

    Matches are ranked: casks that install that .app, then casks whose display
    name is the app's name (pkg-based casks like NordVPN), then casks that only
    delete it on uninstall (microsoft-office also removes OneDrive.app).
    """
    data = None
    fresh = os.path.exists(CACHE) and time.time() - os.path.getmtime(CACHE) < 86400
    if not fresh:
        try:
            with urllib.request.urlopen(CASK_API, timeout=30) as r:
                raw = r.read()
            os.makedirs(os.path.dirname(CACHE), exist_ok=True)
            with open(CACHE, "wb") as f:
                f.write(raw)
        except Exception as e:
            print(f"warning: couldn't fetch {CASK_API} ({e}); using cache", file=sys.stderr)
    try:
        with open(CACHE) as f:
            data = json.load(f)
    except Exception:
        print("warning: no cask index; cask matching skipped", file=sys.stderr)
        return {}

    tiers = ({}, {}, {})

    def add(tier, app, token):
        tokens = tiers[tier].setdefault(os.path.basename(app), [])
        if token not in tokens:
            tokens.append(token)

    for cask in data:
        token = cask["token"]
        for artifact in cask.get("artifacts", []):
            for item in artifact.get("app", []):
                # "Foo.app", or {"target": "Foo.app"} for renamed installs
                if isinstance(item, str):
                    add(0, item, token)
                elif isinstance(item, dict) and item.get("target"):
                    add(0, item["target"], token)
            # pkg-based casks (Zoom, Logi, Office...) only name the .app in
            # their uninstall/delete list.
            for step in artifact.get("uninstall", []):
                if isinstance(step, dict):
                    deletes = step.get("delete", [])
                    for p in [deletes] if isinstance(deletes, str) else deletes:
                        if p.startswith("/Applications/") and p.endswith(".app"):
                            add(2, p, token)
        for name in cask.get("name", []):
            add(1, name + ".app", token)

    index = {}
    for tier in tiers:
        for app, tokens in tier.items():
            # Plain tokens before variants (ghostty before ghostty@tip).
            tokens.sort(key=lambda t: ("@" in t, t))
            index.setdefault(app, []).extend(t for t in tokens if t not in index.get(app, []))
    return index


def brew_casks_installed():
    try:
        out = subprocess.run(["brew", "list", "--cask"], capture_output=True, text=True, check=True)
        return set(out.stdout.split())
    except Exception:
        print("warning: `brew list --cask` failed", file=sys.stderr)
        return set()


def brewfile_casks():
    with open(BREWFILE) as f:
        return set(re.findall(r'^\s*cask\s+"([^"]+)"', f.read(), re.M))


def managed_names(text):
    m = re.search(r"<!-- managed:start -->(.*?)<!-- managed:end -->", text, re.S)
    if not m:
        return set()
    return {line[2:].strip() for line in m.group(1).splitlines() if line.startswith("- ")}


def main():
    with open(APPS_MD) as f:
        text = f.read()
    if BEGIN not in text or END not in text:
        sys.exit(f"{APPS_MD}: missing the GENERATED markers")

    apps = list_apps()
    index = load_cask_index()
    installed = brew_casks_installed()
    in_brewfile = brewfile_casks()
    managed = managed_names(text)

    brew, appstore, work, apple, migrate, manual = [], [], [], [], [], []
    for name, path in apps.items():
        base = os.path.basename(name)
        label = name[:-4]  # drop ".app"
        candidates = index.get(base, [])
        mine = [t for t in candidates if t in installed]
        if mine:
            brew.append((label, mine[0], mine[0] in in_brewfile))
        elif os.path.exists(os.path.join(path, "Contents/_MASReceipt/receipt")):
            appstore.append(label)
        elif label in managed or base[:-4] in managed:
            work.append(label)
        elif bundle_id(path).startswith("com.apple."):
            apple.append(label)
        elif candidates:
            migrate.append((label, candidates[0]))
        else:
            manual.append(label)

    out = [
        BEGIN,
        "",
        f"Snapshot: {datetime.date.today().isoformat()}, {len(apps)} apps "
        f"({len(brew)} Homebrew, {len(appstore)} App Store, {len(work)} work-managed, "
        f"{len(apple)} Apple, {len(migrate)} with a cask available, {len(manual)} manual).",
        "",
        "### Installed by Homebrew",
        "",
        "Reinstalled by `brew bundle install` once the cask is in `./Brewfile`.",
        "",
        "| App | Cask | In Brewfile |",
        "|---|---|---|",
        *[f"| {a} | `{t}` | {'yes' if ok else '**no, add it**'} |" for a, t, ok in brew],
        "",
        "### Cask available: migrate to `./Brewfile`",
        "",
        "Installed by hand today, but a Homebrew cask ships the same app. Add",
        '`cask "<name>"` to the Brewfile, then `brew install --cask --adopt <name>`',
        "to take over the existing copy.",
        "",
        "| App | Cask |",
        "|---|---|",
        *[f"| {a} | `{t}` |" for a, t in migrate],
        "",
        "### App Store",
        "",
        "Reinstall from the App Store (or `mas install <id>`).",
        "",
        *[f"- {a}" for a in appstore],
        "",
        "### Work-managed (MDM)",
        "",
        "Listed under \"Work / enterprise-managed\" above; don't install by hand.",
        "",
        *[f"- {a}" for a in work],
        "",
        "### Apple (ships with macOS)",
        "",
        *[f"- {a}" for a in apple],
        "",
        "### Manual, no cask found",
        "",
        "Record where each comes from in \"Manual downloads\" above.",
        "",
        *[f"- {a}" for a in manual],
        "",
        END,
    ]
    new = text[: text.index(BEGIN)] + "\n".join(out) + text[text.index(END) + len(END):]
    with open(APPS_MD, "w") as f:
        f.write(new)
    print(f"Updated {APPS_MD}: {len(apps)} apps; review with `git diff`, then commit.")


if __name__ == "__main__":
    main()
